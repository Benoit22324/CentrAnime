// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String           @id @default(uuid())
  username                String
  email                   String           @unique
  password                String
  salt                    String
  createdAt               DateTime         @default(now())
  lastLogin               DateTime         @default(now())
  recommandations         Recommandation[]
  likes                   Like[]
  favorites               Favorite[]
  senderContactRequests   ContactRequest[] @relation("SenderRequest")
  receiverContactRequests ContactRequest[] @relation("ReceiverRequest")
  userAContacts           Contact[]        @relation("UserAContact")
  userBContacts           Contact[]        @relation("UserBContact")
  chatMessages            ChatMessage[]
  aniLists                AniList[]
  opinions                Opinion[]
}

model Platform {
  id           String  @id @default(uuid())
  platformName String
  link         String
  ranks        Rank[]
  scores       Score[]
}

model Genre {
  id          String       @id @default(uuid())
  genreName   String
  AnimeGenres AnimeGenre[]
}

model Studio {
  id           String        @id @default(uuid())
  studioName   String
  animeStudios AnimeStudio[]
}

model Rank {
  id         String   @id @default(uuid())
  rank       Int
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  anime      Anime?
}

model Score {
  id         String   @id @default(uuid())
  score      Float
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  anime      Anime?
}

model Anime {
  id                   String                @id @default(uuid())
  main_title           String
  en_title             String
  type                 String
  episodes             Int
  status               String
  posterUrl            String
  startDate            String
  endDate              String
  popularity           Int
  synopsis             String
  updatedAt            DateTime
  rankId               String                @unique
  scoreId              String                @unique
  rank                 Rank                  @relation(fields: [rankId], references: [id], onUpdate: Cascade)
  score                Score                 @relation(fields: [scoreId], references: [id], onUpdate: Cascade)
  animeGenres          AnimeGenre[]
  animeStudios         AnimeStudio[]
  recommandationAnimes RecommandationAnime[]
  aniListAnimes        AniListAnime[]
  opinions             Opinion[]
}

model AnimeGenre {
  id      String @id @default(uuid())
  animeId String
  genreId String
  anime   Anime  @relation(fields: [animeId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model AnimeStudio {
  id       String @id @default(uuid())
  animeId  String
  studioId String
  anime    Anime  @relation(fields: [animeId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  studio   Studio @relation(fields: [studioId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Recommandation {
  id                   String                @id @default(uuid())
  title                String
  description          String
  authorId             String
  author               User                  @relation(fields: [authorId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  likes                Like[]
  favorites            Favorite[]
  recommandationAnimes RecommandationAnime[]
}

model Like {
  id     String         @id @default(uuid())
  recoId String
  userId String
  reco   Recommandation @relation(fields: [recoId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Favorite {
  id     String         @id @default(uuid())
  recoId String
  userId String
  reco   Recommandation @relation(fields: [recoId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model RecommandationAnime {
  id        String         @id @default(uuid())
  animeId   String
  recoId    String
  anime     Anime          @relation(fields: [animeId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  reco      Recommandation @relation(fields: [recoId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model AniList {
  id            String         @id @default(uuid())
  title         String
  userId        String
  user          User           @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  aniListAnimes AniListAnime[]
}

model AniListAnime {
  id        String  @id @default(uuid())
  animeId   String
  aniListId String
  anime     Anime   @relation(fields: [animeId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  aniList   AniList @relation(fields: [aniListId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Opinion {
  id         String @id @default(uuid())
  note       Float
  comment    String
  viewStatus String
  userId     String
  animeId    String
  user       User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  anime      Anime  @relation(fields: [animeId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model ContactRequest {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  senderId   String   @unique
  reveiverId String   @unique
  sender     User     @relation("SenderRequest", fields: [senderId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  receiver   User     @relation("ReceiverRequest", fields: [reveiverId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Contact {
  id      String @id @default(uuid())
  userAId String @unique
  userBId String @unique
  userA   User   @relation("UserAContact", fields: [userAId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userB   User   @relation("UserBContact", fields: [userBId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  chat    Chat?
}

model Chat {
  id           String        @id @default(uuid())
  contactId    String        @unique
  contact      Contact       @relation(fields: [contactId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  chatMessages ChatMessage[]
}

model ChatMessage {
  id       String @id @default(uuid())
  message  String
  chatId   String
  authorId String
  chat     Chat   @relation(fields: [chatId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  author   User   @relation(fields: [authorId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}
